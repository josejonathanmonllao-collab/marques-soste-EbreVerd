                </tr>
                <tr>
                  <td>Transport</td>
                  <td>Cotxe de gasolina o dièsel</td>
                  <td>Cotxe elèctric</td>
                  <td>No emet fums a la ciutat mentre circula.</td>
                </tr>
                <tr>
                  <td>Calefacció</td>
                  <td>Caldera de gasoil</td>
                  <td>Bomba de calor (aerotèrmia)</td>
                  <td>Genera 3 o 4 unitats de calor per cada unitat d'electricitat.</td>
                </tr>
                <tr>
                  <td>Agricultura</td>
                  <td>Reg per inundació</td>
                  <td>Reg per degoteig</td>
                  <td>L'aigua arriba directament a l'arrel i se'n malbarata molt menys.</td>
                </tr>
                <tr>
                  <td>Informàtica</td>
                  <td>Un servidor físic per a cada servei</td>
                  <td>Servidors virtualitzats</td>
                  <td>Menys màquines, menys consum elèctric i menys refrigeració.</td>
                </tr>
              </tbody>
            </table>
